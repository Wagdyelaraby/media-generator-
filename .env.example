# انسخ هذا الملف إلى .env.local محليًا، وأضف نفس القيم في Vercel → Settings → Environment Variables

# قاعدة Turso (إلزاميان)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# عنوان خدمة دمج الفيديو (مشروع Video Merger المنشور على Vercel)
MERGER_API_BASE=https://<merger-app>.vercel.app

# اختياري
# MCP_ACCESS_TOKEN=          # إن ضُبط يُطلب Bearer token على /mcp
# KIE_IMAGE_MODEL=           # تجاوز أسماء الموديلات إن لزم
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=
